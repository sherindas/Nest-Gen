# ─────────────────────────────────────────────────────────────────────────────
# NextGen Service Website — Environment Variables
#
# Copy this file to .env.local and fill in the values before running locally.
# NEVER commit .env.local or any file containing real credentials to version control.
# On Vercel, configure these as project environment variables in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Service Account (for Sheets + Drive access) ───────────────────────
# The email address of the Google service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private key of the service account (PEM format, including header/footer)
# When setting on Vercel, replace literal \n with actual newlines or use the
# raw PEM string — Vercel handles multi-line env vars correctly.
GOOGLE_PRIVATE_KEY=

# The ID of the Google Spreadsheet (from its URL: /spreadsheets/d/{ID}/edit)
GOOGLE_SPREADSHEET_ID=

# The ID of the Google Drive folder where complaint images will be uploaded
GOOGLE_DRIVE_FOLDER_ID=

# ── Resend (email notifications) ─────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The "from" email address used for outbound notifications (must be a verified domain)
RESEND_FROM_EMAIL=

# The team email address that receives submission notifications
NOTIFICATION_EMAIL=

# ── Public configuration (safe to expose to the browser) ─────────────────────
# The company phone number displayed in CTAs and footer (e.g. +91XXXXXXXXXX)
NEXT_PUBLIC_COMPANY_PHONE=

# The WhatsApp number used for wa.me deep links (digits only, e.g. 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
